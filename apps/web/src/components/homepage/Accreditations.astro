---
interface Props {
  accreditationsList: {
    name: string;
    logo: {
      url: string;
      alt: string;
    };
  }[];
}

const { accreditationsList } = Astro.props;
---

<section class="py-24 bg-primary relative overflow-hidden">
  <div class="absolute top-0 left-1/2 w-full max-w-3xl h-[300px] bg-accent/5 rounded-full blur-[100px] -translate-x-1/2 pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-6 mb-16 text-center relative z-10">
    <span class="text-accent font-black tracking-widest uppercase text-xs mb-4 block">Standards of Excellence</span>
    <h2 class="text-3xl md:text-5xl font-black tracking-tight text-white">
      OLOPSC Accreditations and Certification
    </h2>
  </div>

  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 relative z-10">
    {
      accreditationsList.map((accreditation) => (
        <div class="bg-white/5 border border-white/10 p-8 md:p-10 rounded-3xl flex flex-col items-center text-center hover:bg-white/10 hover:-translate-y-1 transition-all duration-300">
          <div class="w-24 h-24 bg-white rounded-2xl flex items-center justify-center p-4 mb-8 shadow-[0_0_20px_rgba(255,255,255,0.1)]">
            <img
              src={accreditation.logo.url}
              alt={accreditation.logo.alt}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="text-xl font-bold text-white leading-snug">
            {accreditation.name}
          </h3>
        </div>
      ))
    }
  </div>
</section>
