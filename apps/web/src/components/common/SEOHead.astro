---
interface Props {
  title?: string;
  rawTitle?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  additionalSchema?: string;
}

const SITE_NAME = "OLOPSC";
const DEFAULT_TITLE = `Official Website | ${SITE_NAME}`;
const DEFAULT_DESCRIPTION =
  "Our Lady of Perpetual Succor College (OLOPSC) — Providing quality education from Preschool to College in Marikina City. Discover our programs, admissions, and scholarships.";
const DEFAULT_OG_IMAGE = "/og-image.jpg";
const SITE_URL =
  Astro.site?.toString().replace(/\/$/, "") || "https://olopsc.edu.ph";

const {
  title,
  rawTitle,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  canonicalUrl,
  noindex = false,
  additionalSchema,
} = Astro.props;

// Build the final title: use rawTitle if provided, otherwise append " | OLOPSC" to custom titles, or use the default
const fullTitle =
  rawTitle || (title ? `${title} | ${SITE_NAME}` : DEFAULT_TITLE);

// Clean the current path (remove trailing slash)
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentUrl = new URL(currentPath || "", SITE_URL).toString().replace(/\/$/, "");

// If a custom canonical URL is provided, strip trailing slash
const customCanonicalUrl = canonicalUrl
  ? canonicalUrl.replace(/\/$/, "")
  : null;

// Build the canonical URL without trailing slashes
const canonical = customCanonicalUrl || currentUrl;

// Build absolute OG image URL
const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, SITE_URL).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content={SITE_NAME} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollegeOrUniversity",
    "@id": "https://www.olopsc.edu.ph/#organization",
    "name": "Our Lady of Perpetual Succor College",
    "alternateName": [
      "OLOPSC",
      "OLOPS College",
