    "image": "https://www.olopsc.edu.ph/og-image.jpg",
    "description": "Our Lady of Perpetual Succor College (OLOPSC) is a private educational institution in Marikina City, Metro Manila, offering Preschool through Senior High School basic education and CHED-recognized college degree programs.",
    "foundingDate": "1978",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Gen. Ordoñez Street, Concepcion Uno",
      "addressLocality": "Marikina City",
      "addressRegion": "Metro Manila",
      "postalCode": "1807",
      "addressCountry": "PH"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 14.6467,
      "longitude": 121.1118
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "+639985957592",
        "contactType": "admissions",
        "areaServed": "PH",
        "availableLanguage": ["English", "Filipino"],
        "description": "Basic Education Admissions (Preschool to Senior High School)"
      },
      {
        "@type": "ContactPoint",
        "telephone": "+639605630970",
        "contactType": "admissions",
        "areaServed": "PH",
        "availableLanguage": ["English", "Filipino"],
        "description": "College Admissions"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/olopsc.official/",
      "https://www.instagram.com/olopsc_official",
      "https://x.com/OLOPSC_OFFICIAL",
      "https://www.youtube.com/@olopscollegeofficial825",
      "https://www.linkedin.com/school/olopscmarikina/"
    ],
    "department": [
      {
